# Run all commands from the repository root. Environment overrides this file.
LLM_MODE=mock
# For real LLM calls: set LLM_MODE=openai, a key, and your provider's model ID.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30
VALIDATION_AGENT_URL=http://127.0.0.1:8001
A2A_TIMEOUT_SECONDS=45
RESEARCH_TIMEOUT_SECONDS=90
