# Run all commands from the repository root. Environment overrides this file.
LLM_MODE=openai
# Research requires a configured provider; no production mock mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30
VALIDATION_AGENT_URL=http://127.0.0.1:8001
A2A_TIMEOUT_SECONDS=45
RESEARCH_TIMEOUT_SECONDS=90

# SQLite is authoritative; Chroma is a rebuildable local index. Paths relative to repo root.
SQLITE_PATH=backend/data/aurum.sqlite3
CHROMA_PATH=backend/data/chroma
# Real local model; provision once using the README command. No chat-time download.
# "fake" is an explicit test-only adapter; it is never selected by LLM_MODE=mock.
MEMORY_EMBEDDING_ADAPTER=sentence_transformers
MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.45
MEMORY_CACHE_SIMILARITY_THRESHOLD=0.92
MEMORY_CACHE_MAX_ENTRIES=128
MEMORY_MAX_CONTEXT_CHARS=6000
MEMORY_RECENT_MESSAGES=4
MEMORY_WORKING_MAX_SESSIONS=128
MEMORY_WORKING_MAX_MESSAGES=20
MEMORY_WORKING_MAX_CHARS=12000

# A quote older than this is explicitly stale, including weekends/market closures.
GOLD_STALE_AFTER_SECONDS=7200
GOLD_HTTP_TIMEOUT_SECONDS=10
GOLD_HTTP_ATTEMPTS=3
# Empty disables the HTTP write trigger; CLI sync remains available. Server-only secret.
INTERNAL_JOB_TOKEN=

# Required when a quantitative engine is registered. No implicit dataset or tool budget.
RESEARCH_DATASET_ID=
RESEARCH_DIAGNOSTIC_BUDGET=2
RESEARCH_SIGNIFICANCE_LEVEL=0.05
